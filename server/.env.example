# AI Alumni Nexus - Server Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String
# For local MongoDB (recommended for local development):
MONGODB_URI=mongodb://127.0.0.1:27017/alumni_nexus
# For MongoDB Atlas (production / cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/alumni_nexus?retryWrites=true&w=majority

# JWT Signing Secret (generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters

# Client Origin for CORS and Cookie exchange
CORS_ORIGIN=http://localhost:5173

# API Rate Limiter (maximum requests per 15-minute window)
RATE_LIMIT_MAX=300

# OpenAI API Key (Optional: if omitted, intelligent rule-based local stubs are used)
# OPENAI_API_KEY=sk-placeholder-not-required-for-local-development

# Environment Mode
NODE_ENV=development
