# AI Alumni Nexus - Monorepo Environment Configuration Template
# Duplicate this file as server/.env or configure each service individually.

# ==============================================================================
# Backend Server Configuration (server/.env)
# ==============================================================================

# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/alumni_nexus
# Production Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/alumni_nexus?retryWrites=true&w=majority

# High-entropy JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=super_secret_jwt_passphrase_production_random_key_min_32_chars

# High-entropy Refresh Token Secret
REFRESH_TOKEN_SECRET=super_secret_refresh_token_passphrase_min_32_chars

# Trusted frontend client URL for CORS & Cookie authorization
CORS_ORIGIN=http://localhost:5173

# Rate limit maximum requests per 15-minute window
RATE_LIMIT_MAX=300

# OpenAI API Key (Optional - server automatically falls back to deterministic heuristic engine if missing)
# OPENAI_API_KEY=sk-...

# Environment mode (development / production)
NODE_ENV=development

# ==============================================================================
# Frontend Client Configuration (client/.env)
# ==============================================================================

# API Base URL (optional: Vite proxy defaults to http://localhost:5000 if unset)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
